# Copy to .env and change every secret before deploying.
FASTAPI_ENV=development
PROJECT_NAME=Resolve
DOMAIN=localhost

# Postgres (pgvector image)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app

# OpenID Connect (Keycloak realm)
OIDC_ISSUER=http://localhost:8081/realms/resolve
OIDC_AUDIENCE=resolve-api
OIDC_ADMIN_ROLE=resolve-admin
OIDC_PUBLIC_URL=http://localhost:8081
KEYCLOAK_ADMIN_PASSWORD=change-me

# MCP server (public URL advertised to clients in OAuth discovery)
MCP_PUBLIC_URL=http://localhost:8010

# Files
STORAGE_ROOT=./data/files
MAX_UPLOAD_MB=50
# LLM gateway (LiteLLM -> DeepInfra, see deploy/litellm.yaml)
DEEPINFRA_API_KEY=your-deepinfra-key
LITELLM_MASTER_KEY=change-me
LLM_BASE_URL=http://localhost:4000/v1
LLM_API_KEY=change-me
EMBED_MODEL=embed
CHAT_MODEL=chat-fast

# Google Form where new people request an account (shown on the sign-in page).
ACCESS_REQUEST_URL=
