# Copy to .env.prod on the server and fill in EVERY value. Never commit .env.prod.
# Generate secrets with:  openssl rand -base64 32 | tr -d '\n=+/' | cut -c1-32

# Your domain. Resolve is served at app.<DOMAIN>, auth.<DOMAIN> and mcp.<DOMAIN>.
DOMAIN=sortitouthq.com

# Let's Encrypt registration / expiry notices.
ACME_EMAIL=you@example.com

# Database (also used by Keycloak's own database).
POSTGRES_PASSWORD=change-me

# Keycloak's bootstrap admin (for the admin console, reachable only via an SSH tunnel).
KEYCLOAK_ADMIN_PASSWORD=change-me

# The first Resolve administrator. The password is temporary: Keycloak makes this
# person choose a new one at first sign-in.
RESOLVE_ADMIN_EMAIL=you@example.com
RESOLVE_ADMIN_INITIAL_PASSWORD=change-me

# LLM provider key (DeepInfra) and the key the app uses to talk to LiteLLM.
DEEPINFRA_API_KEY=your-deepinfra-key
LITELLM_MASTER_KEY=change-me

MAX_UPLOAD_MB=50

# Google Form where new people request an account (shown on the sign-in page).
# Leave empty to hide the button. Baked into the web app at build time.
ACCESS_REQUEST_URL=

# Personal front page at the bare domain (see deploy/site/). Set to `site` to serve it,
# after pointing the apex and www DNS records at this server. Leave empty otherwise.
COMPOSE_PROFILES=
